datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProjectRole {
  ADMIN
  QA
  DEVELOPER
  VENDOR
  CLIENT
  VIEWER
}

enum BugStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  READY_FOR_VERIFICATION
  CLOSED
  REOPENED
  INVALID
  DUPLICATE
  CANNOT_REPRODUCE
  WONT_FIX
}

enum BugSeverity {
  BLOCKER
  HIGH
  MEDIUM
  LOW
}

enum BugPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum CommentType {
  PUBLIC
  INTERNAL
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  image     String?
  status    UserStatus @default(PENDING)
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reviewedById  String?
  reviewedBy    User?     @relation("UserReviewer", fields: [reviewedById], references: [id])
  reviewedUsers User[]    @relation("UserReviewer")
  reviewedAt    DateTime?

  memberships    ProjectMember[]
  reportedBugs   Bug[]           @relation("BugReporter")
  assignedBugs   Bug[]           @relation("BugAssignee")
  reviewedBugs   Bug[]           @relation("BugReviewer")
  coReportedBugs BugCoReporter[] @relation("UserCoReported")
  comments       BugComment[]
  auditLogs      AuditLog[]

  testRunsCreated         TestRun[]
  testItemsExecuted       TestRunItem[]
  attemptsExecuted        TestRunAttempt[]         @relation("AttemptExecutor")
  testRunsClosed          TestRun[]                @relation("TestRunClosedBy")
  apiKeysCreated          ApiKey[]
  runningItems            TestRunItem[]            @relation("ItemRunner")
  chatMessages            ChatMessage[]
  notifications           Notification[]
  focusUntil              DateTime?
  notificationScope       String                   @default("INVOLVED_ONLY")
  notificationPreferences NotificationPreference[]
  testCaseVersions        TestCaseVersion[]

  @@index([status])
  @@index([email])
}

model Project {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "CRM", "PKT"
  name        String
  description String?
  isArchived  Boolean  @default(false)
  isTest      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   ProjectMember[]
  bugs      Bug[]
  bugSeq    Int             @default(0) // auto-incrementing per project for CRM-1, CRM-2
  auditLogs AuditLog[]

  businessDocs            BusinessDoc[]
  testCases               TestCase[]
  testRuns                TestRun[]
  apiKeys                 ApiKey[]
  agentRuns               AgentRun[]
  evidence                Evidence[]
  chatMessages            ChatMessage[]
  modules                 Module[]
  notificationPreferences NotificationPreference[]

  @@index([key])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model Bug {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String  @unique // e.g. "CRM-12"
  number    Int

  title            String
  description      String @default("")
  stepsToReproduce String @default("")
  expectedResult   String @default("")
  actualResult     String @default("")

  // Evidence & context links (http/https only, validated in src/lib/bug-input.ts)
  jamUrl    String?
  taskUrl   String?
  links     String[] @default([])
  related   Bug[]    @relation("BugRelated")
  relatedBy Bug[]    @relation("BugRelated")

  severity BugSeverity
  priority BugPriority @default(NORMAL)
  status   BugStatus   @default(DRAFT)

  environment   String  @default("")
  appVersion    String?
  buildNumber   String?
  browserDevice String?
  component     String? // legacy free text; replaced by moduleId
  moduleId      String?
  module        Module? @relation(fields: [moduleId], references: [id])

  reporterId   String
  reporter     User      @relation("BugReporter", fields: [reporterId], references: [id])
  assigneeId   String?
  assignee     User?     @relation("BugAssignee", fields: [assigneeId], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("BugReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  reopenCount  Int     @default(0)
  reopenReason String?

  // appVersion/buildNumber = "ditemukan di". Fix/verify info below (step 6).
  fixedInVersion  String?
  fixedInBuild    String?
  dueAt           DateTime?
  verifiedAt      DateTime?
  verifiedInBuild String?

  duplicateOfId String?
  duplicateOf   Bug?    @relation("BugDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Bug[]   @relation("BugDuplicates")

  // Phase 2B Bridge
  // Deprecated (Step 10): replaced by testRunLinks; column dropped in a later migration.
  testRunLinks TestRunItemBug[]
  rerunItems   TestRunItem[]    @relation("RerunBug")

  // Phase 3 Agent Run link
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    BugComment[]
  attachments BugAttachment[]

  coReporters    BugCoReporter[] @relation("BugCoReporters")
  mergedAsSource BugCoReporter[] @relation("BugMergedSources")

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assigneeId])
  @@index([reporterId])
}

model BugComment {
  id        String      @id @default(uuid())
  bugId     String
  bug       Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  type      CommentType @default(PUBLIC)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([bugId, type])
}

model BugAttachment {
  id         String   @id @default(uuid())
  bugId      String
  bug        Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  fileName   String
  storedName String   @unique
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  @@index([bugId])
}

model BugCoReporter {
  id          String   @id @default(uuid())
  bugId       String
  bug         Bug      @relation("BugCoReporters", fields: [bugId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserCoReported", fields: [userId], references: [id], onDelete: Cascade)
  sourceBugId String
  sourceBug   Bug      @relation("BugMergedSources", fields: [sourceBugId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([bugId, userId, sourceBugId])
  @@index([bugId])
  @@index([userId])
  @@index([sourceBugId])
}

model AuditLog {
  id         String   @id @default(uuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorType  String   @default("user") // "user" | "agent" | "system"
  action     String // e.g. "bug.create", "bug.status_change", "user.approve"
  entityType String // e.g. "bug", "user", "project_member"
  entityId   String
  changes    Json? // { before: {...}, after: {...} }
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// -------------------------------------------------------------
// Phase 2B: Business Documents & Test Cases Models
// -------------------------------------------------------------

model BusinessDoc {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions BusinessDocVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model BusinessDocVersion {
  id           String      @id @default(uuid())
  docId        String
  doc          BusinessDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  versionNum   Int
  fileName     String
  storedPath   String
  fileSize     Int
  mimeType     String
  isCurrent    Boolean     @default(true)
  uploadedById String?
  uploadedAt   DateTime    @default(now())

  chunks BusinessDocChunk[]

  @@unique([docId, versionNum])
  @@index([docId, isCurrent])
}

model BusinessDocChunk {
  id         String             @id @default(uuid())
  versionId  String
  version    BusinessDocVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  tsv        String? // TSVector for Phase 4 AI FTS search

  @@index([versionId])
}

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestCasePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model TestCase {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String // e.g. "TC-PKT-001"
  moduleArea     String? // legacy free text; replaced by moduleId
  moduleId       String?
  module         Module?          @relation(fields: [moduleId], references: [id])
  title          String
  status         TestCaseStatus   @default(READY)
  priority       TestCasePriority @default(MEDIUM)
  testType       String? // e.g. "Functional", "Negative", "UI"
  targetRole     String? // e.g. "Marketing RS", "RS_Finance"
  precondition   String?
  steps          String // 1) ... 2) ...
  expectedResult String
  referenceUrl   String? // Figma / doc link
  agentReady     Boolean          @default(false)
  testData       Json? // values for {{name}} placeholders in steps; never credentials
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  runItems TestRunItem[]
  versions TestCaseVersion[]

  @@unique([projectId, code])
  @@index([projectId, moduleArea])
  @@index([projectId, status])
}

model TestCaseVersion {
  id          String   @id @default(uuid())
  testCaseId  String
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  version     Int
  changelog   String?
  snapshot    Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  runItems TestRunItem[]
  attempts TestRunAttempt[]

  @@unique([testCaseId, version])
  @@index([testCaseId])
  @@index([createdById])
}

enum TestRunStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model TestRun {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String // e.g. "Regression Run - Sprint 14"
  environment  String // e.g. "Staging"
  buildVersion String? // e.g. "v1.4.2"
  status       TestRunStatus @default(IN_PROGRESS)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  decision     TestRunDecision?
  decisionNote String?
  closedAt     DateTime?
  closedById   String?
  closedBy     User?            @relation("TestRunClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  items         TestRunItem[]
  agentSessions AgentRun[]

  @@index([projectId, status])
}

enum TestRunDecision {
  PASS
  PASS_WITH_NOTES
  FAIL
}

enum TestRunItemStatus {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

model TestRunItem {
  id           String            @id @default(uuid())
  testRunId    String
  testRun      TestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId   String
  testCase     TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status       TestRunItemStatus @default(NOT_RUN)
  actualResult String?
  notes        String?
  executedById String?
  executedBy   User?             @relation(fields: [executedById], references: [id], onDelete: SetNull)
  executedAt   DateTime?

  skipReason        String?
  testCaseVersionId String?
  testCaseVersion   TestCaseVersion? @relation(fields: [testCaseVersionId], references: [id], onDelete: SetNull)
  needsRerun        Boolean          @default(false)
  rerunBuild        String?
  rerunBugId        String?
  rerunBug          Bug?             @relation("RerunBug", fields: [rerunBugId], references: [id], onDelete: SetNull)

  // Agent lease: running* set by claim, extended by heartbeat, expired when leaseExpiresAt < now
  runningByUserId  String?
  runningBy        User?     @relation("ItemRunner", fields: [runningByUserId], references: [id], onDelete: SetNull)
  runningAgentName String?
  runningSince     DateTime?
  heartbeatAt      DateTime?
  leaseExpiresAt   DateTime?
  currentStep      Int?
  totalSteps       Int?

  attempts TestRunAttempt[]
  bugLinks TestRunItemBug[]

  @@unique([testRunId, testCaseId])
  @@index([testRunId, status])
  @@index([rerunBugId])
}

model TestRunAttempt {
  id                String            @id @default(uuid())
  itemId            String
  item              TestRunItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seq               Int
  result            TestRunItemStatus
  actualResult      String?
  notes             String?
  build             String?
  environment       String?
  evidenceUrl       String?
  testCaseVersionId String?
  testCaseVersion   TestCaseVersion?  @relation(fields: [testCaseVersionId], references: [id], onDelete: SetNull)
  executedById      String?
  executedBy        User?             @relation("AttemptExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  viaAgent          Boolean           @default(false)
  agentName         String?
  toolName          String?
  agentSessionId    String?
  agentSession      AgentRun?         @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  bugLinks TestRunItemBug[]
  evidence Evidence[]

  @@unique([itemId, seq])
}

// F9: file evidence uploaded by an agent. File is deleted from disk when the result is PASS (purgedAt set).
model Evidence {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  sessionId    String?
  fileName     String
  storedName   String
  mimeType     String
  fileSize     Int
  attemptId    String?
  attempt      TestRunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  purgedAt     DateTime?
  createdAt    DateTime        @default(now())

  @@index([attemptId])
  @@index([projectId, purgedAt, createdAt])
}

model TestRunItemBug {
  itemId    String
  item      TestRunItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bugId     String
  bug       Bug             @relation(fields: [bugId], references: [id], onDelete: Cascade)
  attemptId String?
  attempt   TestRunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@id([itemId, bugId])
  @@index([bugId])
}

// -------------------------------------------------------------
// Phase 3: MCP & AI Agent Models
// -------------------------------------------------------------

enum ApiKeyPreset {
  AGENT_QA
  READ_ONLY
  CUSTOM
}

model ApiKey {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // e.g. "Claude Code MCP - QA Regression"
  keyHash     String       @unique // sha256 hash of plaintext key
  keyPrefix   String // e.g. "br_live_abc..."
  scopes      String[] // ["bug:read", "bug:create", "bug:comment", "bug:attach"]
  role        ProjectRole  @default(QA)
  expiresAt   DateTime?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  preset      ApiKeyPreset @default(CUSTOM)
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  agentRuns AgentRun[]

  @@index([projectId, revokedAt])
}

model ApiKeyRateLimit {
  id         String   @id @default(uuid())
  keyHash    String
  windowSlot DateTime // e.g. bucketed to 1 minute
  callCount  Int      @default(0)

  @@unique([keyHash, windowSlot])
  @@index([windowSlot])
}

model AgentRun {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeyId    String?
  apiKey      ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  agentName   String // e.g. "claude-code", "playwright-reporter"
  modelName   String? // e.g. "claude-3-7-sonnet"
  runId       String // unique identifier passed by the agent run
  createdBugs Bug[]
  createdAt   DateTime @default(now())

  // Agent session (F9)
  toolName   String?
  workdir    String?
  testRunId  String?
  testRun    TestRun?         @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  summary    Json?
  attempts   TestRunAttempt[]

  @@unique([projectId, runId])
  @@index([projectId, createdAt])
}

// -------------------------------------------------------------
// Phase 4: Project AI Chat Models
// -------------------------------------------------------------

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id         String          @id @default(uuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ChatMessageRole
  content    String
  citations  Json? // [{ type: "bug" | "doc", key: "CRM-1" | "PRD v1" }]
  tokenUsage Json? // { inputTokens: 100, outputTokens: 200 }
  createdAt  DateTime        @default(now())

  @@index([projectId, userId, createdAt])
}

// Per-project master list of application modules under test. Managed by project admins.
model Module {
  id         String     @id @default(uuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int        @default(0)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bugs       Bug[]
  testCases  TestCase[]

  @@unique([projectId, name])
}

// In-app notification. Pruned after 90 days on write (see src/lib/notify.ts).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  type      String // assign | comment | status | draft | rerun | agent_session | doc_approval | mention | user_pending
  title     String
  body      String    @default("")
  href      String
  actorName String    @default("")
  sessionId String?
  heldUntil DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

enum NotificationDeliveryMode {
  IMMEDIATE
  DAILY
  PER_SESSION
  OFF
}

model NotificationPreference {
  id        String                   @id @default(uuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // assign | comment | status | draft | rerun | agent_session | doc_approval | mention
  mode      NotificationDeliveryMode @default(IMMEDIATE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([userId, projectId, type])
  @@index([userId])
}
