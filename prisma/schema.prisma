datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProjectRole {
  ADMIN
  QA
  DEVELOPER
  VENDOR
  CLIENT
  VIEWER
}

enum BugStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  READY_FOR_VERIFICATION
  CLOSED
  REOPENED
  INVALID
  DUPLICATE
  CANNOT_REPRODUCE
  WONT_FIX
}

enum BugSeverity {
  BLOCKER
  HIGH
  MEDIUM
  LOW
}

enum BugPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum CommentType {
  PUBLIC
  INTERNAL
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  image         String?
  status        UserStatus   @default(PENDING)
  isAdmin       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reviewedById  String?
  reviewedBy    User?        @relation("UserReviewer", fields: [reviewedById], references: [id])
  reviewedUsers User[]       @relation("UserReviewer")
  reviewedAt    DateTime?

  memberships   ProjectMember[]
  reportedBugs  Bug[]        @relation("BugReporter")
  assignedBugs  Bug[]        @relation("BugAssignee")
  reviewedBugs  Bug[]        @relation("BugReviewer")
  comments      BugComment[]
  auditLogs     AuditLog[]

  testRunsCreated   TestRun[]
  testItemsExecuted TestRunItem[]

  @@index([status])
  @@index([email])
}

model Project {
  id          String          @id @default(uuid())
  key         String          @unique // e.g. "CRM", "PKT"
  name        String
  description String?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  bugs        Bug[]
  bugSeq      Int             @default(0) // auto-incrementing per project for CRM-1, CRM-2
  auditLogs   AuditLog[]

  businessDocs BusinessDoc[]
  testCases    TestCase[]
  testRuns     TestRun[]

  @@index([key])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model Bug {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key             String         @unique // e.g. "CRM-12"
  number          Int

  title           String
  description     String
  stepsToReproduce String
  expectedResult  String
  actualResult    String

  severity        BugSeverity
  priority        BugPriority    @default(NORMAL)
  status          BugStatus      @default(DRAFT)

  environment     String
  appVersion      String?
  buildNumber     String?
  browserDevice   String?
  component       String?

  reporterId      String
  reporter        User           @relation("BugReporter", fields: [reporterId], references: [id])
  assigneeId      String?
  assignee        User?          @relation("BugAssignee", fields: [assigneeId], references: [id])
  reviewedById    String?
  reviewedBy      User?          @relation("BugReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  reopenCount     Int            @default(0)
  reopenReason    String?

  duplicateOfId   String?
  duplicateOf     Bug?           @relation("BugDuplicates", fields: [duplicateOfId], references: [id])
  duplicates      Bug[]          @relation("BugDuplicates")

  // Phase 2B Bridge
  testRunItemId   String?        @unique
  testRunItem     TestRunItem?   @relation("TestRunItemBug", fields: [testRunItemId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments        BugComment[]
  attachments     BugAttachment[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assigneeId])
  @@index([reporterId])
}

model BugComment {
  id        String      @id @default(uuid())
  bugId     String
  bug       Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  type      CommentType @default(PUBLIC)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([bugId, type])
}

model BugAttachment {
  id          String   @id @default(uuid())
  bugId       String
  bug         Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  fileName    String
  storedName  String   @unique
  fileSize    Int
  mimeType    String
  uploadedAt  DateTime @default(now())

  @@index([bugId])
}

model AuditLog {
  id          String   @id @default(uuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorType   String   @default("user") // "user" | "agent" | "system"
  action      String   // e.g. "bug.create", "bug.status_change", "user.approve"
  entityType  String   // e.g. "bug", "user", "project_member"
  entityId    String
  changes     Json?    // { before: {...}, after: {...} }
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// -------------------------------------------------------------
// Phase 2B: Business Documents & Test Cases Models
// -------------------------------------------------------------

model BusinessDoc {
  id          String               @id @default(uuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  versions    BusinessDocVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model BusinessDocVersion {
  id          String             @id @default(uuid())
  docId       String
  doc         BusinessDoc        @relation(fields: [docId], references: [id], onDelete: Cascade)
  versionNum  Int
  fileName    String
  storedPath  String
  fileSize    Int
  mimeType    String
  isCurrent   Boolean            @default(true)
  uploadedById String?
  uploadedAt  DateTime           @default(now())

  chunks      BusinessDocChunk[]

  @@unique([docId, versionNum])
  @@index([docId, isCurrent])
}

model BusinessDocChunk {
  id         String             @id @default(uuid())
  versionId  String
  version    BusinessDocVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  tsv        String?            // TSVector for Phase 4 AI FTS search

  @@index([versionId])
}

enum TestCasePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model TestCase {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String           // e.g. "TC-PKT-001"
  moduleArea     String?          // Area e.g. "Dashboard", "Buat Paket"
  title          String
  priority       TestCasePriority @default(MEDIUM)
  testType       String?          // e.g. "Functional", "Negative", "UI"
  targetRole     String?          // e.g. "Marketing RS", "RS_Finance"
  precondition   String?
  steps          String           // 1) ... 2) ...
  expectedResult String
  referenceUrl   String?          // Figma / doc link
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  runItems       TestRunItem[]

  @@unique([projectId, code])
  @@index([projectId, moduleArea])
}

enum TestRunStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model TestRun {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String        // e.g. "Regression Run - Sprint 14"
  environment  String        // e.g. "Staging"
  buildVersion String?       // e.g. "v1.4.2"
  status       TestRunStatus @default(IN_PROGRESS)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        TestRunItem[]

  @@index([projectId, status])
}

enum TestRunItemStatus {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
}

model TestRunItem {
  id           String            @id @default(uuid())
  testRunId    String
  testRun      TestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId   String
  testCase     TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status       TestRunItemStatus @default(NOT_RUN)
  actualResult String?
  notes        String?
  executedById String?
  executedBy   User?             @relation(fields: [executedById], references: [id], onDelete: SetNull)
  executedAt   DateTime?

  createdBug   Bug?              @relation("TestRunItemBug")

  @@unique([testRunId, testCaseId])
  @@index([testRunId, status])
}
