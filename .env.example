# Copy to .env and replace every placeholder with local or deployment values.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:<DB_PORT>/<DB_NAME>?schema=public"
AUTH_SECRET="replace-with-random-secret-at-least-32-characters"
ADMIN_EMAILS="admin@example.test"
AUTH_GOOGLE_ID="<GOOGLE_CLIENT_ID>"
AUTH_GOOGLE_SECRET="<GOOGLE_CLIENT_SECRET>"
NEXTAUTH_URL="http://localhost:3001"
# Kosong/"mock" = chat AI jalan di simulation mode
ANTHROPIC_API_KEY=""
ENABLE_DEV_LOGIN="false"
# Domain email staf internal (tanpa @). Kosong = semua akun dianggap eksternal.
INTERNAL_EMAIL_DOMAIN=""
